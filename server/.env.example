# PhotoChain – server/ környezeti változók
# Másold le .env néven, és töltsd ki. A .env SOHA nem kerülhet a repóba (lásd .gitignore).
# Az éles változók mintája: .env.production.example (L32).
# Az ellenőrzésük: server/src/config/env.ts – hibás vagy hiányzó értéknél a szerver el sem indul.

# --- Szerver (mind elhagyható, zárójelben az alapérték) ---
# NODE_ENV=development        # development | test | production
# PORT=4000
# LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent
# RATE_LIMIT_WINDOW_MS=900000 # a sebességkorlát időablaka (15 perc)
# RATE_LIMIT_MAX=300          # ennyi kérés engedélyezett IP-címenként egy időablakban
# AUTH_RATE_LIMIT_MAX=20      # ezen belül a bejelentkezés + regisztráció együttes korlátja
# LOGIN_ACCOUNT_RATE_LIMIT_MAX=10  # fiókonként (e-mail-címenként) ennyi sikertelen belépés egy időablakban (L30)
# DHASH_THRESHOLD=10          # két kép másolatnak számít, ha a dHash-ük legfeljebb ennyi bitben tér el (0–64)
# UPLOAD_DIR=uploads          # a feltöltött képek mappája (alapból server/uploads; a git nem követi)
# UPLOAD_MAX_BYTES=15728640   # egy feltöltött képfájl legnagyobb mérete bájtban (15 MB)
# UPLOAD_MAX_CONCURRENT=4     # ennyi feltöltést fogad egyszerre a szerver, felhasználónként egyet (a többi 503 / 429)
# UPLOAD_RATE_LIMIT_MAX=30    # ennyi feltöltési kísérlet engedélyezett felhasználónként egy időablakban
# UPLOAD_DAILY_LIMIT=30       # ennyi feltöltés (= lánc-tranzakció) fiókonként 24 óra alatt (L30)
# UPLOAD_GLOBAL_DAILY_LIMIT=500  # ennyi feltöltés a platformon összesen 24 óra alatt – a tárca költségkerete (L30)
# UPLOAD_BODY_TIMEOUT_MS=150000  # a feltöltött fájlnak ennyi ms alatt meg kell érkeznie (a 3 perces kérés-időkorláton belül, L30)
# VERIFY_RATE_LIMIT_MAX=20    # nyilvános hitelesség-ellenőrzés (/api/verify): ennyi kérés IP-címenként egy időablakban
# VERIFY_CHAIN_READ_LIMIT=200 # legfeljebb ennyi láncolvasás egy időablakban, minden kliensre együtt (az RPC-kvóta védelme)
# VERIFY_MAX_CONCURRENT=2     # ennyi fájl-ellenőrzés futhat egyszerre, IP-címenként egy (a többi 503 / 429)
# VERIFY_BODY_TIMEOUT_MS=30000  # az ellenőrizendő fájlnak ennyi ms alatt meg kell érkeznie (legfeljebb 600000)

# --- Munkamenet (JWT) ---
# A munkamenet-tokenek aláíró kulcsa: legalább 32 karakter hosszú VÉLETLEN érték. Előállítása:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Ha megváltozik, minden bejelentkezett felhasználó munkamenete érvényét veszti.
JWT_SECRET=

# --- Adatbázis (PostgreSQL 17 a Docker Compose-ból, lásd a gyökér docker-compose.yml-t) ---
# Formátum: postgresql://FELHASZNÁLÓ:JELSZÓ@localhost:5432/ADATBÁZIS – a felhasználó és a jelszó
# ugyanaz, mint a gyökér .env POSTGRES_USER és POSTGRES_PASSWORD értéke.
DATABASE_URL=
# Az adatbázis-tesztek külön adatbázisa (a neve kötelezően „_test” végű, mert a tesztek minden
# futáskor kiürítik; a `prisma migrate deploy` magától létrehozza), pl. …/photochain_test
TEST_DATABASE_URL=

# --- Seed (npm run db:seed): az adminisztrátor és a két demó felhasználó belépési adatai ---
# Csak a seed használja; a jelszavak legalább 8 karakteresek legyenek.
SEED_ADMIN_EMAIL=admin@photochain.test
SEED_ADMIN_PASSWORD=
# A két demó felhasználó (fotos@photochain.test, vasarlo@photochain.test) közös jelszava
SEED_DEMO_PASSWORD=

# --- Blokklánc ---
# JSON-RPC végpont: Sepolia (Alchemy), fejlesztéskor lehet a lokális Hardhat-hálózat is
# (http://127.0.0.1:8545). Csak https:// lehet (az URL-ben az API-kulcs is benne van); http csak a
# helyi gépre (localhost, 127.0.0.1).
RPC_URL=

# A hálózat azonosítója (elhagyható, alapból 11155111 = Sepolia; a lokális Hardhat-hálózaté 31337 –
# más hálózat nem engedélyezett). A PhotoRegistry címe ehhez a hálózathoz a
# server/src/contracts/PhotoRegistry.json-ból jön.
# CHAIN_ID=11155111

# A tranzakció díjának plafonja gwei-ben (elhagyható, alapból 50; legfeljebb 10000): ha a hálózat
# ennél többet kér, a regisztráció nem megy ki (CHAIN_FAILED, később újrapróbálható).
# CHAIN_MAX_FEE_GWEI=50

# A platform-tárca privát kulcsa, 0x előtaggal – ez írja alá a regisztrációs tranzakciókat.
# Ugyanaz, mint a blockchain/.env SEPOLIA_PRIVATE_KEY értéke.
# CSAK erre a célra létrehozott teszttárca kulcsa legyen, valódi pénz nélkül!
PLATFORM_PRIVATE_KEY=

# --- Stripe (teszt mód) ---
# Titkos kulcs: Stripe Dashboard → Developers → API keys. KIZÁRÓLAG sk_test_ kezdetű kulcs!
STRIPE_SECRET_KEY=
# A webhook-aláírás titka (whsec_ kezdetű): fejlesztéskor a `stripe listen --events <a checkout.session.*
# események> --forward-to localhost:4000/api/webhooks/stripe` parancs írja ki (a pontos parancs a
# README-ben), élesben a Dashboard webhook-végpontja adja.
STRIPE_WEBHOOK_SECRET=
# A kliens (webes felület) eredete – a Stripe a fizetés után ide irányít vissza
# (/checkout/success, /checkout/cancel). Elhagyható, alapból a Vite fejlesztői szervere; élesben
# https:// kell.
# APP_BASE_URL=http://localhost:5173
# --- Kiszolgálás (L31) ---
# TRUST_PROXY_HOPS=          # a megbízható fordított proxyk száma (alapból éles módban 1, egyébként 0; a Docker-képben 0, a Renderen mérve 3 – L32)
# CLIENT_DIST_DIR=           # a kliens buildjének mappája – ha meg van adva, a szerver a webes felületet is kiszolgálja (a konténerben /app/client)
# Ennyi fizetésindítás engedélyezett felhasználónként egy időablakban (elhagyható, alapból 20)
# CHECKOUT_RATE_LIMIT_MAX=20
# Ennyi lánc-regisztráció újrapróbálás engedélyezett adminonként egy időablakban – minden
# újrapróbálás tranzakció, gázdíjba kerül (elhagyható, alapból 10)
# CHAIN_RETRY_RATE_LIMIT_MAX=10

# --- Élesítés (L32; fejlesztéskor mind elhagyható – az éles minta: .env.production.example) ---
# STORAGE_DRIVER=local        # local | supabase – a képek tárhelye
# SUPABASE_URL=               # a Supabase-projekt címe (https://<projekt>.supabase.co)
# SUPABASE_SECRET_KEY=        # a szerver titkos kulcsa (sb_secret_…) – csak a szerveren!
# SUPABASE_ORIGINALS_BUCKET=originals  # az eredeti képek privát bucketje
# SUPABASE_PREVIEWS_BUCKET=previews    # az előnézetek és bélyegképek privát bucketje (a szerver adja tovább)
# STORAGE_TIMEOUT_MS=20000    # egy tárhely-művelet időkorlátja
# MEDIA_RATE_LIMIT_MAX=600    # a /media kérései IP-címenként időablakonként (minden kérés adatbázis-lekérdezés; távoli tárhelynél a szerver adja tovább a képeket)
# DATABASE_SSL_CA_FILE=       # az adatbázis tanúsítványát aláíró CA (PEM) – megadva ellenőrzött TLS
# IMAGE_MAX_MEGAPIXELS=50     # a kép legfeljebb ennyi megapixeles lehet (1–50; az ingyenes Renderen 25)
# IMAGE_PROCESSING_CONCURRENCY=4  # ennyi kép bontása fut egyszerre (feltöltés + ellenőrzés + visszaállítás; Renderen 1)
# Élesben (NODE_ENV=production) az APP_BASE_URL kötelező.
