# PhotoChain – éles változók (L32). Másold le server/.env.production néven, és töltsd ki: a git és a
# Docker-build is kizárja, a tartalmát SOHA ne oszd meg. Ugyanezek az értékek kerülnek a Render
# szolgáltatás Environment beállításai közé (render.yaml: sync: false), és ebből olvas a saját gépről
# futtatott két élesítési parancs is (npm run production:migrate, production:seed – server/scripts/production.ts).
# A változók szabályai: server/src/config/env.ts és server/.env.example.

NODE_ENV=production
# A Render-szolgáltatás nyilvános címe (https://<név>.onrender.com) – élesben kötelező
APP_BASE_URL=
# Legalább 32 karakteres véletlen érték (a Render a render.yaml alapján maga is előállíthatja)
JWT_SECRET=

# Supabase → Connect → Session pooler (5432-es port, IPv4) – sslmode NÉLKÜL: a tanúsítványt a
# DATABASE_SSL_CA_FILE adja (a konténerben /app/server/certs/supabase-prod-ca-2021.crt; a render.yaml
# beállítja, a helyi parancsok a server/certs mappából veszik)
DATABASE_URL=

# Sepolia (Alchemy) – ugyanaz a végpont és tárca, mint fejlesztéskor
RPC_URL=
PLATFORM_PRIVATE_KEY=

# Stripe teszt mód: a titkos kulcs, és a Dashboard webhook-végpontjának titka (NEM a stripe listen-é)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Storage: a projekt címe és a titkos kulcs (sb_secret_…; Project Settings → API Keys)
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Az ingyenes Render-példány (512 MB, 0,1 CPU) korlátai – a mérés: docs/fejlesztesi-naplo.md, L32
IMAGE_MAX_MEGAPIXELS=25
IMAGE_PROCESSING_CONCURRENCY=1
VERIFY_MAX_CONCURRENT=1
UPLOAD_MAX_CONCURRENT=2

# Csak a seedhez (npm run production:seed): az éles adminisztrátor és a két demó fiók belépési adatai
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
