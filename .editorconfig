# EditorConfig – egységes alapbeállítások minden szerkesztőben
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdownban a sor végi két szóköz sortörést jelent, ezért nem vágjuk le
[*.md]
trim_trailing_whitespace = false

# Solidity: a hivatalos stílusútmutató 4 szóközös behúzást ír elő
[*.sol]
indent_size = 4

# Windows-parancsfájlok (lásd .gitattributes)
[*.{bat,cmd,ps1}]
end_of_line = crlf
